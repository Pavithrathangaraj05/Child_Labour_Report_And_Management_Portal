# Copy to .env  (or run: npm run setup:env  to generate one with random secrets)
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/child_safe

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
UPLOAD_TOKEN_SECRET=

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# Comma-separated list of allowed browser origins
FRONTEND_ORIGIN=http://localhost:5173
# Set to 1 when running behind a reverse proxy / load balancer
TRUST_PROXY=0

UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25

# Password used ONLY by `npm run seed` for fictional demo users (refused in production)
SEED_PASSWORD=

# Email / SMTP Configuration for OTP Mail Validation
# For Gmail, set SMTP_SERVICE=gmail, SMTP_USER=your_email@gmail.com, and SMTP_PASS=your_16_digit_app_password
# For other SMTP providers, set SMTP_HOST, SMTP_PORT (e.g. 587 or 465), SMTP_USER, SMTP_PASS, SMTP_SECURE
SMTP_SERVICE=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=
